# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Ambiente / credenciais
.env
*.local.toml

# Dados de ensaio (arquivos grandes / brutos nao versionados)
dados/brutos/*
dados/processados/*
!dados/brutos/.gitkeep
!dados/processados/.gitkeep

# PDFs de referencia (direitos autorais / tamanho)
referencias/pdfs/*
!referencias/pdfs/.gitkeep

# Saidas geradas
# So a pasta figuras/ da raiz. As de docs/registros/ e docs/apresentacoes/ sao
# versionadas: os registros e os slides apontam para elas.
/figuras/
*.pdf.bak

# Sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Acervo de ensaios: versionado (36 MB, fonte primaria, nao editar)
!dados/Ensaios-270/
